# Threshold — copy to .env and fill in. .env is gitignored. NEVER commit a real key.
# Throwaway keys with testnet funds only. Never prefix a secret with NEXT_PUBLIC_.

# ─────────────────────────────────────────────────────────────────────────────
# Network — Somnia Shannon testnet (chain 50312).
# RPC/WS/explorer confirmed from docs.somnia.network on 2026-09-02.
# ─────────────────────────────────────────────────────────────────────────────
SOMNIA_SHANNON_RPC=https://api.infra.testnet.somnia.network
SOMNIA_SHANNON_WS_RPC=wss://api.infra.testnet.somnia.network/ws
SOMNIA_EXPLORER_URL=https://shannon-explorer.somnia.network
SOMNIA_EXPLORER_API_URL=https://shannon-explorer.somnia.network/api
SOMNIA_CHAIN_ID=50312
EXPLORER_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Keys
# ─────────────────────────────────────────────────────────────────────────────
# Deploys contracts and funds the registry/subscriber. Needs >= ~33 STT on Shannon
# (32 for SUBSCRIPTION_OWNER_MINIMUM_BALANCE + gas). PHASE 0 BLOCKER-1.
DEPLOYER_PRIVATE_KEY=0x
# Places the crossing orders in the demo / PHASE 0.6. MUST differ from any quoter's
# key — DreamDEX blocks self-matching.
DEMO_TRADER_PRIVATE_KEY=0x

# ─────────────────────────────────────────────────────────────────────────────
# DreamDEX — protocol addresses are CREATE3-deterministic, identical on both chains.
# ─────────────────────────────────────────────────────────────────────────────
DREAMDEX_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
BINARY_MODULE=0x3ecC694Cef705358864a646142ac17A90E29e388
MARKETS_CORE=0x2802504314685D89bF6C992CA5a8e7cC78bc0294
BINARY_SETTLEMENT=0xbF4a49e0Dfd092e5FBE8E5761064C49533e6Ed23
ORACLE_HUB=0xe40db387cC98601Dd11bd634fF2f3AD5686dE32b
COLLATERAL_TOKEN=0x70a86D8842FB63C4Ad2b7cdddF530eBf1BB25d8E
# Venue ids MOVE (3x in the first week of Aug 2026). Leave blank and let
# pnpm phase0:discover read it off a live market row, then paste it back.
VENUE_ID=

# ─────────────────────────────────────────────────────────────────────────────
# PHASE 0 targets — filled in by pnpm phase0:discover, then deployment.
# ─────────────────────────────────────────────────────────────────────────────
TARGET_MARKET_ID=
TARGET_POOL=
SUBSCRIBER_ADDRESS=
CROSS_SIZE=5

# ─────────────────────────────────────────────────────────────────────────────
# Threshold contracts (post-deploy)
# ─────────────────────────────────────────────────────────────────────────────
THRESHOLD_REGISTRY=0xb31014A95Da14e94900a5b8c58087E8f754e596d
THRESHOLD_HANDLER=0x693DC66E334674d5FF1ECf846d64E5086187195e
DEMO_VAULT=0xcAc26cFD38d72F8730dEFA46a271D055246a1463

# ─────────────────────────────────────────────────────────────────────────────
# Reactivity subscription tuning (optional — defaults are the SDK defaults)
# maxFeePerGas >= priorityFeePerGas + 6 gwei ; gasLimit <= 200_000_000
# ─────────────────────────────────────────────────────────────────────────────
SUBSCRIPTION_GAS_LIMIT=10000000
SUBSCRIPTION_MAX_FEE_PER_GAS=20000000000
SUBSCRIPTION_PRIORITY_FEE_PER_GAS=1000000000

# ─────────────────────────────────────────────────────────────────────────────
# Frontend — web/ (all public, never secret). web/.env.local mirrors these.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_RPC_URL=https://api.infra.testnet.somnia.network
NEXT_PUBLIC_WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
NEXT_PUBLIC_CHAIN_ID=50312
NEXT_PUBLIC_EXPLORER_URL=https://shannon-explorer.somnia.network
NEXT_PUBLIC_DREAMDEX_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
NEXT_PUBLIC_VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c
NEXT_PUBLIC_REGISTRY_ADDRESS=0xb31014A95Da14e94900a5b8c58087E8f754e596d
NEXT_PUBLIC_HANDLER_ADDRESS=0x693DC66E334674d5FF1ECf846d64E5086187195e
NEXT_PUBLIC_DEMO_VAULT_ADDRESS=0xcAc26cFD38d72F8730dEFA46a271D055246a1463
